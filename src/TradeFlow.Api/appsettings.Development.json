{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "TradeFlow": "Debug"
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=tradeflow;Username=postgres;Password=postgres",
    "RabbitMq": "amqp://guest:guest@localhost:5672/",
    "Kafka": "localhost:9092",
    "Redis": "localhost:6379",
    "Otlp": "http://localhost:4317"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/tradeflow",
    "Audience": "tradeflow-api",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Outbox": {
    "BackgroundWorkerEnabled": true
  }
}
