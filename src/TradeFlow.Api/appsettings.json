{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=tradeflow;Username=postgres;Password=postgres",
    "RabbitMq": "amqp://guest:guest@localhost:5672/",
    "Kafka": "localhost:9092",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/tradeflow",
    "Audience": "tradeflow-api",
    "RequireHttpsMetadata": true
  },
  "Outbox": {
    "BackgroundWorkerEnabled": true
  }
}
