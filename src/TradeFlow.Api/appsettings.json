{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=tradeflow;Username=postgres;Password=postgres",
    "RabbitMq": "amqp://guest:guest@localhost:5672/",
    "Kafka": "localhost:9092",
    "Redis": "localhost:6379",
    "Otlp": "http://localhost:4317"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/tradeflow",
    "Audience": "tradeflow-api",
    "RequireHttpsMetadata": true
  },
  "Outbox": {
    "BackgroundWorkerEnabled": true
  },
  "Resilience": {
    "LoadShedding": {
      "MaxConcurrentRequests": 200
    },
    "RateLimiting": {
      "WindowSeconds": 60,
      "TenantPermitLimit": 100,
      "AuthPermitLimit": 15
    },
    "Keycloak": {
      "TotalTimeoutSeconds": 10.0,
      "BulkheadPermitLimit": 20,
      "BulkheadQueueLimit": 10,
      "MaxRetries": 2,
      "RetryBaseDelayMs": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerSamplingSeconds": 30.0,
      "CircuitBreakerBreakSeconds": 15.0,
      "AttemptTimeoutSeconds": 3.0
    }
  }
}
