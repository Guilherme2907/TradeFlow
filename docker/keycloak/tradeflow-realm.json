{
  "realm": "tradeflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "Trader",
        "description": "B2B Trader authorized to create, modify, and submit purchase orders for their assigned customer tenant."
      },
      {
        "name": "RiskManager",
        "description": "Risk Officer authorized to inspect orders and execute emergency order cancellations across tenants."
      },
      {
        "name": "ComplianceAuditor",
        "description": "Compliance Auditor with read-only inspection access across orders."
      },
      {
        "name": "Admin",
        "description": "Platform Administrator with full operational access."
      }
    ]
  },
  "clients": [
    {
      "clientId": "tradeflow-api",
      "name": "TradeFlow B2B API Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5041/*",
        "https://localhost:7289/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "customer-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "customer_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "customer_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tradeflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "trader.alpha",
      "email": "trader.alpha@alphacorp.com",
      "firstName": "Alice",
      "lastName": "Trader",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "customer_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "trader123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-tradeflow",
        "Trader"
      ]
    },
    {
      "username": "trader.beta",
